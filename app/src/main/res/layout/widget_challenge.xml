<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_rounded_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_day_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_ripple"
        android:text="90 Day Challenge"
        android:textColor="@color/widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_row_ripple"
        android:text="Loading…"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/widget_row_ripple"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_item_2"
